# masiva.ec - generado por build.py (no editar a mano en el servidor)
# El bloque de PHP de cPanel (handler) se conserva aparte: ver htaccess-cpanel.txt

DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) WHMCS y validaciones SSL: no se tocan
RewriteRule ^wclientes(/|$) - [L]
RewriteRule ^\.well-known/ - [L]

# 2) HTTPS siempre y sin www
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.masiva\.ec$ [NC]
RewriteRule ^ https://masiva.ec%{REQUEST_URI} [R=301,L]

# 3) URLs del sitio anterior
RewriteRule ^apple-supera-a-amazon-y-google-y-se-convierte-en-la-marca-mas-valiosa-del-mundo/?$ /blog/ [R=301,NE,L]
RewriteRule ^beneficios-de-comprar-likes-en-instagram/?$ /blog/ [R=301,NE,L]
RewriteRule ^beneficios-de-la-robotica-aplicada-a-la-medicina/?$ /chatbots-agentes-ia/ [R=301,NE,L]
RewriteRule ^chat-bot/?$ /chatbots-agentes-ia/ [R=301,NE,L]
RewriteRule ^consejos-para-un-buen-uso-de-la-tecnologia-en-ninos/?$ /blog/ [R=301,NE,L]
RewriteRule ^contactenos/?$ /contacto/ [R=301,NE,L]
RewriteRule ^correos-electronicos-emails-masivos-mailing/?$ /email/ [R=301,NE,L]
RewriteRule ^covid-mascarilla-nasal/?$ /blog/ [R=301,NE,L]
RewriteRule ^distanciamiento-fisico-acercamiento-virtual/?$ /blog/ [R=301,NE,L]
RewriteRule ^el-increible-marketing-infantil/?$ /blog/ [R=301,NE,L]
RewriteRule ^hiru-el-primer-dispositivo-multiplataforma-que-activa-maquinas-con-la-mirada/?$ /blog/ [R=301,NE,L]
RewriteRule ^home/?$ / [R=301,NE,L]
RewriteRule ^informacion-sms/?$ /sms/ [R=301,NE,L]
RewriteRule ^inteligencia-artificial-ayuda-a-predecir-la-evolucion-de-los-pacientes-con-covid-19/?$ /chatbots-agentes-ia/ [R=301,NE,L]
RewriteRule ^los-mejores-auriculares-auricular-bluetooth-del-futuro/?$ /blog/ [R=301,NE,L]
RewriteRule ^omegle-una-de-las-redes-sociales-mas-peligrosas/?$ /blog/ [R=301,NE,L]
RewriteRule ^omnicanalidad/?$ /chatbots-agentes-ia/ [R=301,NE,L]
RewriteRule ^pagina-calculadora/?$ /sms/ [R=301,NE,L]
RewriteRule ^que-son-las-criptomonedas/?$ /blog/ [R=301,NE,L]
RewriteRule ^sms-internacional/?$ /sms/#internacional [R=301,NE,L]
RewriteRule ^sms-mensajes-de-texto-masivos/?$ /sms/ [R=301,NE,L]
RewriteRule ^stalkerware-aplicaciones-poco-eticas/?$ /blog/ [R=301,NE,L]
RewriteRule ^tecnoestres-salud-digital/?$ /blog/ [R=301,NE,L]
RewriteRule ^tecnologia-innovadora-telemedicina/?$ /blog/ [R=301,NE,L]
RewriteRule ^tecnologia-led-en-los-juegos-olimpicos-2022/?$ /blog/ [R=301,NE,L]
RewriteRule ^tecnologia-para-disfrutar-el-arte/?$ /blog/ [R=301,NE,L]
RewriteRule ^un-amigo-para-frank-la-humanidad-del-robot/?$ /blog/ [R=301,NE,L]
RewriteRule ^whatsapp-marketing-whatsapp-masivo-bulk/?$ /whatsapp/ [R=301,NE,L]
RewriteRule ^(category|tag|author)/ /blog/ [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ /blog/ [R=301,L]
RewriteRule ^wp-(login|signup|activate|cron|trackback|comments-post)\.php$ - [G,L]
RewriteRule ^xmlrpc\.php$ - [G,L]
RewriteRule ^wp-(admin|includes|content|json)(/|$) - [G,L]
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json text/xml application/xml
</IfModule>

# Seguridad básica
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors On
   php_value max_execution_time 300
   php_value max_input_time 120
   php_value max_input_vars 4000
   php_value memory_limit 512M
   php_value post_max_size 256M
   php_value session.gc_maxlifetime 3600
   php_value session.save_path "/var/cpanel/php/sessions/ea-php74"
   php_value upload_max_filesize 256M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors On
   php_value max_execution_time 300
   php_value max_input_time 120
   php_value max_input_vars 4000
   php_value memory_limit 512M
   php_value post_max_size 256M
   php_value session.gc_maxlifetime 3600
   php_value session.save_path "/var/cpanel/php/sessions/ea-php74"
   php_value upload_max_filesize 256M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
